# Data never goes in git (ADA 2025 is hundreds of GB)
data/
*.tif
*.tiff
*.ply
*.pcd
*.npy
*.npz
*.parquet
*.zip

# Derived tables are shared through git; large derived files are not
!derived/**/*.parquet
cache/

# Python
.venv/
__pycache__/
*.egg-info/
*.pyc
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local tooling
.claude/

# Third-party clones, model weights, training outputs, logs
external/
models/
runs/
logs/
*.pt
*.pt2
*.safetensors
*.ckpt

# Per-workdir caches made by scripts/setup_gpu.sh
.cache/
